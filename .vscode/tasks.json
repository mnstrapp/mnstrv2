{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "flutter: get dependencies",
			"type": "flutter",
			"command": "dart",
			"args": [
				"pub",
				"get"
			],
			"presentation": {
				"revealProblems": "onProblem",
				"close": true
			}
		},
		{
			"label": "flutter: install protoc cli",
			"type": "flutter",
			"command": "dart",
			"args": [
				"pub",
				"global",
				"activate",
				"protoc_plugin"
			],
			"presentation": {
				"revealProblems": "onProblem",
				"close": true
			}
		},
		{
			"label": "flutter: install pubcache",
			"type": "flutter",
			"command": "dart",
			"detail": "Install pubcache",
			"args": [
				"run",
				"bin/install_pubcache.dart"
			],
			"presentation": {
				"revealProblems": "onProblem",
				"close": true
			}
		},
		{
			"label": "flutter: generate protobuf",
			"type": "shell",
			"command": "protoc",
			"detail": "Generate protobuf",
			"args": [
				"--dart_out=grpc:lib/proto",
				"-I",
				"proto/",
				"proto/*.proto"
			],
			"options": {
				"env": {
					"PATH": "${env:HOME}/.pub-cache/bin:${env:PATH}"
				}
			},
			"dependsOn": [
				"flutter: get dependencies",
				"flutter: install protoc cli",
				"flutter: install pubcache"
			],
			"presentation": {
				"revealProblems": "onProblem",
				"close": true
			}
		},
		{
			"label": "flutter: generate models",
			"type": "flutter",
			"command": "dart",
			"args": [
				"run",
				"build_runner",
				"build",
				"--delete-conflicting-outputs"
			],
			"dependsOn": [
				"flutter: get dependencies",
				"flutter: generate protobuf"
			],
			"presentation": {
				"revealProblems": "onProblem",
				"close": true
			}
		},
		{
			"type": "flutter",
			"command": "flutter",
			"args": [
				"build",
				"web",
				"--release"
			],
			"group": "build",
			"problemMatcher": [
				"$dart-build_runner"
			],
			"label": "flutter: flutter build web",
			"detail": "Build web release",
			"dependsOn": [
				"flutter: generate models"
			],
			"presentation": {
				"revealProblems": "onProblem",
				"close": true
			}
		},
		{
			"type": "flutter",
			"command": "flutter",
			"args": [
				"build",
				"appbundle",
				"--release"
			],
			"group": "build",
			"problemMatcher": [
				"$dart-build_runner"
			],
			"label": "flutter: flutter build appbundle",
			"detail": "Build appbundle release",
			"dependsOn": [
				"flutter: generate models"
			],
			"presentation": {
				"revealProblems": "onProblem",
				"close": true
			}
		},
		{
			"type": "flutter",
			"command": "flutter",
			"args": [
				"build",
				"ipa",
				"--release"
			],
			"group": "build",
			"problemMatcher": [
				"$dart-build_runner"
			],
			"label": "flutter: flutter build ipa",
			"detail": "Build ipa release",
			"dependsOn": [
				"flutter: generate models"
			],
			"presentation": {
				"revealProblems": "onProblem",
				"close": true
			}
		}
	]
}